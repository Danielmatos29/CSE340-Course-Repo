<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/js/nav.js" defer></script>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
        <span class="nav-brand">CSE 340 Network</span>
        <button class="nav-toggle" aria-controls="nav-menu" aria-expanded="false" aria-label="Toggle navigation"></button>
        <ul id="nav-menu">
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Service Projects</a></li>
            <li><a href="/categories">Categories</a></li>
            <% if (isLoggedIn) { %>
                <li class="nav-auth"><a href="/logout">Logout</a></li>
            <% } else { %>
                <li class="nav-auth"><a href="/register">Register</a></li>
                <li class="nav-auth"><a href="/login">Login</a></li>
            <% } %>
        </ul>
    </nav>
    
    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            
                <% messages[type].forEach(msg => { %>
                    <div class="alert <%= type %>">
                        <%= msg %>
                    </div>
                <% }); %>
        <% } %>
    <% }); %>