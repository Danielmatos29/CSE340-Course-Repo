<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/edit-organization/<%=organizationDetails.organization_id%>" method="POST">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        minlength="3" 
        maxlength="150"
        value="<%=organizationDetails.name%>"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        maxlength="500" 
        required
      ><%=organizationDetails.description%></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        maxlength="255" 
        value="<%=organizationDetails.contact_email%>"
        required
      />
    </div>

    <div class="form-group">
      <label for="logoFile">Logo Filename</label>
      <input
        type="text"
        id="logoFile"
        name="Logo Filename"
        maxlength="255"
        value="<%=organizationDetails.logo_filename%>"
        required
      />
    </div>

    <button type="submit">Create Organization</button>
  </form>

</main>
<%- include('partials/footer') %>