<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul class="project-list">
        <% projects.forEach(function(prj) { %>
            <li>
                <strong><%=prj.date %>: <%=prj.title %>, <%=prj.name %></strong>
                <p><a href="/project/<%=prj.project_id%>"><%= prj.title %> Details</a></p>
                <p><a href="/organization/<%=prj.organization_id%>"><%= prj.name %> Details</a></p>
                <% if (user && user.role_name === 'admin') { %>
                    <p><a href="/assign-categories/<%=prj.project_id%>">Assign Categories</a></p>
                <% } %>
            </li>
        <% }); %>
    </ul>
    <p><a href="/new-project">Add a new Service Project</a></p>
</main>
<%- include('partials/footer') %>