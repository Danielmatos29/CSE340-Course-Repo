<%- include('partials/header') %>
<main>
    <h1><%=projectDetails.title%></h1>
    <p><%=projectDetails.description%></p>
    <p><%=projectDetails.date%></p>
    <p><%=projectDetails.location%></p>
    <p><a href="/organization/<%=projectDetails.organization_id%>"><%=projectDetails.name%></a></p>
    <ul>
         <% categoriesByProject.forEach(function(category){ %>
            <li><a href="/category/<%=category.category_id%>"><%=category.category_name%></a></li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>