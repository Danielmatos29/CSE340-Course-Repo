<%- include('partials/header')%>
<main>
    <h1><%= title %></h1>
    <h2>Users</h2>
    <ul class="project-list">
        <% users.forEach(function(user) { %>
            <li>
            <strong><%= user.name %></strong>
            <span class="user-meta"><strong><%= user.email %> · <%= user.role_name %></strong></span>
        </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>