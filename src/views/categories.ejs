<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Explore our service opportunities by category:</p>
    <nav class="category-nav">
        <ul>
            <% categories.forEach(function(cat) { %>
                <li>
                    <strong><a href="/category/<%=cat.category_id%>"><%=cat.category_name %></a></strong>
                    <p><a href="/edit-category/<%=cat.category_id%>">Edit this category</a></p>
                </li>
            <% }); %>
        </ul>
    </nav>
    <p><a href="/new-category">Add your category!</a></p>
</main>
<%- include('partials/footer') %>
