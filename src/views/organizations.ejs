<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach(function(organization) { %>
            <li class="org-item">
                <a href="/organization/<%=organization.organization_id %>" target="_blank" rel="noopener noreferrer" <%= organization.name %> >
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> Logo" class="org-logo">
                    <strong><%=organization.name %></strong>: <%= organization.contact_email %>
                </a>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>
