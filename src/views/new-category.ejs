<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/new-category" method="POST">
    <div class="form-group">
      <label for="cname">Category Name</label>
      <input
        type="text"
        id="cname"
        name="cname"
        minlength="3" 
        maxlength="150" 
        required
      />
    </div>

    <button type="submit">Create Category</button>
  </form>

</main>
<%- include('partials/footer') %>